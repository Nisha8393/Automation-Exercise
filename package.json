{
  "name": "automation-exercise-playwright",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:a11y": "playwright test --grep @a11y",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports/playwright",
    "coverage": "node scripts/coverage.js",
    "sync-specs": "node scripts/syncSpecs.js"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "page-object-model",
    "qa"
  ],
  "author": "",
  "license": "ISC",
  "description": "End-to-end Playwright test suite for automationexercise.com using the Page Object Model",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.10.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "exceljs": "^4.4.0",
    "node-fetch": "^3.3.2"
  }
}
