{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["**/*.js"],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results",
    "blob-report"
  ]
}
